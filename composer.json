{
    "name": "henrotaym/laravel-temporary-files",
    "description": "laravel-temporary-files",
    "keywords": [
        "henrotaym",
        "laravel",
        "laravel-temporary-files"
    ],
    "homepage": "https://github.com/henrotaym/laravel-temporary-files",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0",
        "spatie/laravel-package-tools": "^1.12",
        "spatie/temporary-directory": "^2.2"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Henrotaym\\LaravelTemporaryFiles\\": "src/",
            "Henrotaym\\LaravelTemporaryFiles\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Henrotaym\\LaravelTemporaryFiles\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Henrotaym\\LaravelTemporaryFiles\\LaravelTemporaryFilesServiceProvider"
            ],
            "aliases": {
                "LaravelTemporaryFiles": "Henrotaym\\LaravelTemporaryFiles\\Facades\\LaravelTemporaryFiles"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
